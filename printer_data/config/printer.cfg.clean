[include mainsail.cfg]
########################################
# MACHINE
########################################

[printer]
kinematics: cartesian
max_velocity: 300
max_accel: 3000

max_velocity: 200
max_accel: 2000
square_corner_velocity: 5.0


[gcode_button power_button]
pin: ^PC13
press_gcode:
    TOGGLE_PSU

[force_move]
enable_force_move: true
	
########################################
# MCU
########################################

[mcu]
serial: /dev/serial/by-id/usb-Klipper_stm32g0b1xx_3600590015504D5930393520-if00
restart_method: command

########################################
# X AXIS – SENSORLESS
########################################

[stepper_x]
step_pin: PB13
dir_pin: PB12
enable_pin: !PB14
microsteps: 16
rotation_distance: 40

endstop_pin: tmc2209_stepper_x:virtual_endstop
position_endstop: 0
position_min: 0
position_max: 300

homing_speed: 40
homing_retract_dist: 0

[tmc2209 stepper_x]
uart_pin: PC11
tx_pin: PC10
uart_address: 0
run_current: 0.80
hold_current: 0.50
stealthchop_threshold: 0
diag_pin: ^PC0  # <<< CHECK THIS >>>
driver_SGTHRS: 85

########################################
# Y AXIS - SENSORLESS HOME CONFIG
########################################

[stepper_y]
step_pin: PB10
dir_pin: PB2
enable_pin: !PB11
microsteps: 16
rotation_distance: 40

# Use virtual endstop specifically for sensorless
endstop_pin: tmc2209_stepper_y:virtual_endstop

# Axis limits
position_min: 0
position_max: 250
position_endstop: 0  # Home is at the minimum

homing_positive_dir: false
homing_speed: 60
homing_retract_dist: 0

[tmc2209 stepper_y]
uart_pin: PC11
tx_pin: PC10
uart_address: 2
run_current: 1.2      # Adjust based on motor specs
hold_current: 0.7
stealthchop_threshold: 0  # Depending on performance needs
diag_pin: ^PC1
driver_SGTHRS: 120  # Adjust as needed based on testing

########################################
# Z Axis - Mechanical Switches
########################################

[stepper_z]
step_pin: PB0
dir_pin: !PC5  # Flip to !PC5 if Z direction inverted (bed should lower to home)
enable_pin: !PB1
microsteps: 16
rotation_distance: 8  # Stock Tr8x8 leadscrew
endstop_pin: ^!PC2  # Stock Z limit (bottom)
position_endstop: 300
position_min: 0
position_max: 300
homing_speed: 10
homing_retract_dist: 10


########################################
# Z PROBE
########################################

#[probe]
#pin: ^PC14      # <<< CHECK THIS >>>
#x_offset: 0
#y_offset: 0
#z_offset: 0
#speed: 5.0
#samples: 2
#samples_result: median
#sample_retract_dist: 2

########################################
# SAFE Z HOME
########################################

[safe_z_home]
home_xy_position: 150,125
speed: 80
z_hop: 10
z_hop_speed: 10

########################################
# BED MESH (OPTIONAL, SAFE DEFAULT)
########################################

[bed_mesh]
speed: 120
horizontal_move_z: 5
mesh_min: 20,20
mesh_max: 280,230
probe_count: 5,5
algorithm: bicubic

########################################
# EXTRUDER (PLACEHOLDER)
########################################

[extruder]
step_pin: PB3
dir_pin: !PB4
enable_pin: !PD1
microsteps: 16
rotation_distance: 7.0
nozzle_diameter: 0.4
filament_diameter: 1.75
heater_pin: PC8
min_extrude_temp: 170
min_temp: 0
max_temp: 300
max_extrude_only_distance: 300
sensor_type: Trianglelab-NTC100K-B3950
sensor_pin: PA0
control: pid
pid_Kp: 22.2
pid_Ki: 1.08
pid_Kd: 114
min_temp: 0
max_temp: 280

[thermistor Trianglelab-NTC100K-B3950]
temperature1: 25
resistance1: 103180
temperature2: 150
resistance2: 1366.2
temperature3: 250
resistance3: 168.6
########################################
# BED
########################################

[heater_bed]
heater_pin: PC9
sensor_type: Trianglelab-NTC100K-B3950
sensor_pin: PC4
control: pid
pid_Kp: 50.0
pid_Ki: 1.0
pid_Kd: 900.0
min_temp: 0
max_temp: 150
########################################
# FANS (SAFE DEFAULTS)
########################################

[fan]
pin: PC6

[heater_fan hotend_fan]
pin: PC7
heater: extruder
heater_temp: 50.0

########################################
# DISPLAY (DISABLED FOR NOW)
########################################
# Add later once motion is stable
