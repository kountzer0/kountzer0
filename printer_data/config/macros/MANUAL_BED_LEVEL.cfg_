[gcode_macro MANUAL_BED_LEVEL]
gcode:
  G28                       # Home all axes (Z to bottom-endstop, X/Y to back-right)
  M84                       # Disable steppers for manual movement
  RESPOND TYPE=command MSG="Starting manual bed level - adjust screws at each point"

  # --- Front-left screw ---
  G0 Z10 F3000              # Lift Z for safe move
  G0 X0 Y0 F3000
  G0 Z0.2 F300
  RESPOND TYPE=command MSG="Front-left (X0 Y0): Adjust screw and paper test. Press RESUME when done."
  PAUSE
  SET_GCODE_OFFSET Z=0      # Record current Z as offset for front-left

  # --- Front-right screw ---
  G0 Z10 F3000
  G0 X300 Y0 F3000
  G0 Z0.2 F300
  RESPOND TYPE=command MSG="Front-right (X300 Y0): Adjust screw and paper test. Press RESUME when done."
  PAUSE
  SET_GCODE_OFFSET Z=0      # Record current Z as offset for front-right

  # --- Rear-center screw ---
  G0 Z10 F3000
  G0 X150 Y250 F3000
  G0 Z0.2 F300
  RESPOND TYPE=command MSG="Rear-center (X150 Y250): Adjust screw and paper test. Press RESUME when done."
  PAUSE
  SET_GCODE_OFFSET Z=0      # Record current Z as offset for rear-center

  # --- Done ---
  G0 Z10 F3000
  G28 X Y                   # Home X/Y
  M84                       # Disable steppers
  RESPOND TYPE=command MSG="Manual bed level complete. Z-offsets recorded."
