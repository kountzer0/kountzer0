[gcode_macro HEATBREAK_FAN_RAMP]
description: Gradually ramp heatbreak fan from 0.18 to 0.35
gcode:
    {% set duration = 60 %}           # ramp duration in seconds
    {% set start_speed = 0.18 %}
    {% set end_speed = 0.35 %}
    {% for i in range(0, duration) %}
        {% set speed = start_speed + (i/duration)*(end_speed - start_speed) %}
        SET_FAN_SPEED FAN=heatbreak_fan SPEED={{speed}}
        G4 S1                         # wait 1 second
    {% endfor %}
