########################################
# Z PROBE
########################################

#[probe]
#pin: ^PC14      # <<< CHECK THIS >>>
#x_offset: 0
#y_offset: 0
#z_offset: 0
#speed: 5.0
#samples: 2
#samples_result: median
#sample_retract_dist: 2
[idle_timeout]
timeout: 100


########################################
# SAFE Z HOME
########################################

[safe_z_home]
home_xy_position: 100,100
speed: 80
z_hop: 10
z_hop_speed: 10

########################################
# BED MESH (OPTIONAL, SAFE DEFAULT)
########################################

[bed_mesh]
speed: 120
horizontal_move_z: 5
mesh_min: 20,20
mesh_max: 280,230
probe_count: 5,5
algorithm: bicubic

########################################
# EXTRUDER (PLACEHOLDER)
########################################

[extruder]
step_pin: PB3
dir_pin: !PB4
enable_pin: !PD1
microsteps: 16
rotation_distance: 7.0
nozzle_diameter: 0.4
filament_diameter: 1.75
heater_pin: PC8
##sensor_type: EPCOS 100K B57560G104F
#sensor_pin: PA0
#control: pid
#   The chip select line for the sensor chip. This parameter must be
#   provided.
#spi_speed: 4000000
#   The SPI speed (in hz) to use when communicating with the chip.
#   The default is 4000000.
#spi_bus: spi2
#spi_software_sclk_pin:
#spi_software_mosi_pin:
#spi_software_miso_pin:
#   See the "common SPI settings" section for a description of the
#   above parameters.
min_extrude_temp: 170
min_temp: 0
max_temp: 300
max_extrude_only_distance: 300
sensor_type: Trianglelab-NTC100K-B3950
sensor_pin: PA0
control: pid
pid_Kp: 22.2
pid_Ki: 1.08
pid_Kd: 114
min_temp: 0
max_temp: 280

[thermistor Trianglelab-NTC100K-B3950]
temperature1: 25
resistance1: 103180
temperature2: 150
resistance2: 1366.2
temperature3: 250
resistance3: 168.6
########################################
# BED
########################################

[heater_bed]
heater_pin: PC9
sensor_type: Trianglelab-NTC100K-B3950
sensor_pin: PC4
control: pid
pid_Kp: 50.0
pid_Ki: 1.0
pid_Kd: 900.0
min_temp: 0
max_temp: 150
########################################
# FANS (SAFE DEFAULTS)
########################################

[temperature_fan system_fan]
pin: PC6
sensor_type: temperature_host
min_temp: 10
max_temp: 80
target_temp: 50
min_speed: 0.3
max_speed: 1.0
control: watermark
kick_start_time: 0.5
cycle_time: 0.01

[temperature_sensor raspberry_pi]
sensor_type: temperature_host
min_temp: 0
max_temp: 85

#[heater_fan]

#pin: PC7
#heater: extruder

#heater_temp: 40.0

#fan_speed: 0.01

