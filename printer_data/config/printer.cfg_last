[include mainsail.cfg]
[include macros/*.cfg]
########################################
# MACHINE
########################################

[printer]
kinematics: cartesian
max_velocity: 300
max_accel: 3000

max_velocity: 200
max_accel: 2000
square_corner_velocity: 5.0


[gcode_button power_button]
pin: ^PC13
press_gcode:
    TOGGLE_PSU

[force_move]
enable_force_move: true
	
########################################
# MCU
########################################

[mcu]
serial: /dev/serial/by-id/usb-Klipper_stm32g0b1xx_3600590015504D5930393520-if00
restart_method: command

########################################
# X AXIS – SENSORLESS
########################################

[stepper_x]
step_pin: PB13
dir_pin: PB12
enable_pin: !PB14
microsteps: 16
rotation_distance: 33.2

endstop_pin: tmc2209_stepper_x:virtual_endstop
position_endstop: 0
position_min: 0
position_max: 300

homing_speed: 40
homing_retract_dist: 0

[tmc2209 stepper_x]
uart_pin: PC11
tx_pin: PC10
uart_address: 0
run_current: 0.80
hold_current: 0.50
stealthchop_threshold: 0
diag_pin: ^PC0  # <<< CHECK THIS >>>
driver_SGTHRS: 80

########################################
# Y AXIS - SENSORLESS HOME CONFIG
########################################

[stepper_y]
step_pin: PB10
dir_pin: PB2
enable_pin: !PB11
microsteps: 16
rotation_distance: 33.2

# Use virtual endstop specifically for sensorless
endstop_pin: tmc2209_stepper_y:virtual_endstop

# Axis limits
position_min: 0
position_max: 250
position_endstop: 0  # Home is at the minimum

homing_positive_dir: false
homing_speed: 60
homing_retract_dist: 0

[tmc2209 stepper_y]
uart_pin: PC11
tx_pin: PC10
uart_address: 2
run_current: 1.2      # Adjust based on motor specs
hold_current: 0.7
stealthchop_threshold: 0  # Depending on performance needs
diag_pin: ^PC1
#driver_SGTHRS: 140  # Adjust as needed based on testing
driver_SGTHRS: 160  # Adjust as needed based on testing
########################################
# Z Axis - Mechanical Switches
########################################

[stepper_z]
step_pin: PB0
dir_pin: !PC5  # Flip to !PC5 if Z direction inverted (bed should lower to home)
enable_pin: !PB1
microsteps: 16
rotation_distance: 8  # Stock Tr8x8 leadscrew
endstop_pin: ^!PC2  # Stock Z limit (bottom)
#position_endstop: 300
#position_min: 0
#position_max: 300
#homing_speed: 10
#homing_retract_dist: 30

########################################
#         Test settings                #
########################################

position_min: -0.4
position_max: 297.310
homing_speed: 8
homing_retract_dist: 20
second_homing_speed: 1
# for z endstop z homing
#endstop_pin: !PC13
position_endstop: 297.300
homing_positive_dir: True

########################################
# Z AXIS – PROBE HOMING
########################################

### temp edit #
